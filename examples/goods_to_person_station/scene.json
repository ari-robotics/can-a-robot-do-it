{
  "name": "Goods-to-person pick station",
  "description": "Distribution-centre pick station: a mobile shelf pod docks into a black portal; the operator picks an item from a pod cell and drops it into a tote on the left. Rebuilt from three phone photos.",
  "frame": "Origin on the floor at the centre of the pod opening, in the plane of the black portal. +y goes into the pod, -y is the operator side, +x is the operator's right, z up. Metres.",
  "scale_references": [
    "Black and red totes: 600 x 400 mm Euro footprint",
    "A4 instruction sheets on the black panel (210 x 297 mm)",
    "22-inch touch screen",
    "Two-step stool risers",
    "Standard 1 m pod footprint"
  ],
  "assumptions": [
    "No pod was docked in the photos: pod geometry (4 columns, 250 mm cell pitch, 2.3 m high) is assumed from the pods visible in the background.",
    "Screen and sensor mast positions are approximate.",
    "The step stool is removed for the robot layout."
  ],
  "params": {
    "pod_gap":   {"value": 0.10, "sigma": 0.05, "min": 0.02, "note": "portal plane to pod face"},
    "pod_w":     {"value": 0.95, "sigma": 0.06, "note": "pod face width"},
    "pod_h":     {"value": 2.30, "sigma": 0.20, "note": "pod height"},
    "bin_depth": {"value": 0.40, "sigma": 0.05, "note": "cell depth"},
    "bin_pitch": {"value": 0.25, "sigma": 0.04, "min": 0.17, "max": 0.35, "note": "vertical pitch of the cells"},
    "bin_z0":    {"value": 0.20, "sigma": 0.05, "note": "bottom of the lowest cell"},
    "open_w":    {"value": 1.10, "sigma": 0.08, "note": "clear opening between portal columns"},
    "tote_dx":   {"value": 0.55, "sigma": 0.10, "note": "portal column to tote centre, to the left"},
    "tote_y":    {"value": -0.35, "sigma": 0.10, "note": "tote centre along the operator axis"},
    "tote_rim":  {"value": 1.12, "sigma": 0.07, "note": "tote rim height"}
  },
  "components": [
    {"type": "box", "name": "portal_left",  "pos": ["-(open_w/2 + 0.08)", 0, 1.25], "size": [0.16, 0.26, 2.5], "color": "black"},
    {"type": "box", "name": "portal_right", "pos": ["open_w/2 + 0.08", 0, 1.25],    "size": [0.16, 0.26, 2.5], "color": "black"},
    {"type": "box", "name": "portal_beam",  "pos": [0, 0, 2.56], "size": ["open_w + 0.32", 0.26, 0.12], "color": "black"},
    {"type": "shelf_unit", "name": "pod", "origin": [0, "pod_gap", 0], "width": "pod_w", "height": "pod_h", "depth": 1.0,
     "bin_depth": "bin_depth", "ncol": 4, "pitch": "bin_pitch", "z0": "bin_z0", "color": "yellow", "pick": true},
    {"type": "tote", "name": "tote", "center": ["-(open_w/2 + 0.16 + tote_dx)", "tote_y"], "rim": "tote_rim", "size": [0.6, 0.4, 0.32], "color": "black", "place": true},
    {"type": "tote", "name": "tote_red", "center": ["-(open_w/2 + 0.16 + tote_dx)", "tote_y - 0.45"], "rim": "tote_rim", "size": [0.6, 0.4, 0.32], "color": "red", "place": false},
    {"type": "box", "name": "tote_rack", "pos": ["-(open_w/2 + 0.16 + tote_dx)", "tote_y - 0.22", "(tote_rim - 0.32)/2"], "size": [0.72, 1.0, "tote_rim - 0.32"], "color": "galvanised"},
    {"type": "box", "name": "work_table", "pos": ["-(open_w/2 + 0.11 + tote_dx)", "tote_y - 1.25", 0.39], "size": [0.84, 1.0, 0.78], "color": "steel"},
    {"type": "box", "name": "sensor_mast", "pos": ["-(open_w/2 + 0.26)", -0.22, 1.20], "size": [0.06, 0.06, 2.4], "color": "galvanised"},
    {"type": "box", "name": "camera", "pos": ["-(open_w/2 + 0.26)", -0.22, 2.42], "size": [0.20, 0.10, 0.08], "color": "black"},
    {"type": "box", "name": "touch_screen", "pos": ["-(open_w/2 + 0.24)", -0.30, 1.50], "size": [0.50, 0.04, 0.30], "color": "white"}
  ],
  "task": {
    "description": "Pick one item from a pod cell and drop it into the black tote.",
    "pick_inset": 0.20,
    "pre_offset": 0.12
  },
  "robot": {
    "candidates": ["UR5e", "UR10e", "CRX-5iA"],
    "tool": {"type": "suction_wand", "length": 0.38},
    "base_search": {"x": [-0.9, -0.3, 5], "y": [-0.8, -0.4, 3], "pedestal": [0.4, 1.3, 4]},
    "observation_camera": {"pos": [-0.85, -1.25, 2.25], "target": [0.0, 0.25, 1.15], "fovy": 60}
  }
}
